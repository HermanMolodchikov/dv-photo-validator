<UserControl x:Class="DvPhotoValidator.App.Views.CropEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DvPhotoValidator.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CropEditorViewModel}">
    <!-- The canvas has fixed logical size; Viewbox scales it, and GetPosition() returns canvas coordinates. -->
    <Viewbox Stretch="Uniform">
        <Canvas x:Name="Surface"
                Width="560" Height="560"
                ClipToBounds="True"
                Background="#FF2B2B2E"
                Focusable="True"
                FocusVisualStyle="{x:Null}"
                Cursor="SizeAll"
                AutomationProperties.Name="Редактор кадрирования. Стрелки сдвигают фото, плюс и минус меняют масштаб."
                MouseLeftButtonDown="Surface_MouseLeftButtonDown"
                MouseMove="Surface_MouseMove"
                MouseLeftButtonUp="Surface_MouseLeftButtonUp"
                LostMouseCapture="Surface_LostMouseCapture"
                MouseWheel="Surface_MouseWheel"
                KeyDown="Surface_KeyDown">

            <Image Source="{Binding Image}"
                   Canvas.Left="{Binding ImageLeft}" Canvas.Top="{Binding ImageTop}"
                   Width="{Binding ImageWidth}" Height="{Binding ImageHeight}"
                   Stretch="Fill"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   IsHitTestVisible="False" />

            <!-- Dim everything outside the square frame (even-odd fill leaves a hole). -->
            <Path Fill="#A6000000" IsHitTestVisible="False"
                  Data="F0 M0,0 L560,0 L560,560 L0,560 Z M40,40 L520,40 L520,520 L40,520 Z" />

            <!-- Allowed bands: eye line, and chin position given the head-top guide. -->
            <Rectangle Canvas.Left="40" Width="480" Canvas.Top="{Binding EyeZoneTop}" Height="{Binding EyeZoneHeight}"
                       Fill="#2600E676" Stroke="#8000E676" StrokeThickness="1" StrokeDashArray="2 3" IsHitTestVisible="False" />
            <Rectangle Canvas.Left="40" Width="480" Canvas.Top="{Binding ChinZoneTop}" Height="{Binding ChinZoneHeight}"
                       Fill="#1F40C4FF" IsHitTestVisible="False" />

            <Rectangle Canvas.Left="40" Canvas.Top="40" Width="480" Height="480"
                       Stroke="White" StrokeThickness="2" IsHitTestVisible="False" />
            <Line X1="280" X2="280" Y1="40" Y2="520" Stroke="#99FFFFFF" StrokeThickness="1"
                  StrokeDashArray="4 4" IsHitTestVisible="False" />

            <TextBlock Canvas.Left="44" Canvas.Top="524" Foreground="#FFB0B0B0" FontSize="11" IsHitTestVisible="False"
                       Text="Зелёная полоса — допустимая линия глаз; голубая — допустимый подбородок." />

            <!-- Detected face box and keypoints, so the user can see what the detector found. -->
            <Rectangle Canvas.Left="{Binding FaceBoxLeft}" Canvas.Top="{Binding FaceBoxTop}"
                       Width="{Binding FaceBoxWidth}" Height="{Binding FaceBoxHeight}"
                       Stroke="#CCFFD740" StrokeThickness="1" StrokeDashArray="3 3" IsHitTestVisible="False"
                       Visibility="{Binding HasFace, Converter={StaticResource BoolToVisibility}}" />
            <ItemsControl ItemsSource="{Binding FaceMarkers}" IsHitTestVisible="False" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Ellipse Width="6" Height="6" Margin="-3,-3,0,0" Fill="#FFFFD740" Stroke="#FF5D4000" StrokeThickness="0.5" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Draggable guides. Dashed = not placed yet. -->
            <Canvas Canvas.Top="{Binding TopGuideY}" Tag="HeadTop" Cursor="SizeNS"
                    MouseLeftButtonDown="Guide_MouseLeftButtonDown">
                <Rectangle Canvas.Left="0" Canvas.Top="-7" Width="560" Height="14" Fill="Transparent" />
                <Line X1="20" X2="540" Y1="0" Y2="0" Stroke="#FFFF6E6E" StrokeThickness="2" StrokeDashArray="{Binding TopDash}" />
                <TextBlock Canvas.Left="44" Canvas.Top="-19" Text="{Binding TopLabel}" Foreground="#FFFF6E6E" FontSize="12" FontWeight="SemiBold" />
            </Canvas>

            <Canvas Canvas.Top="{Binding EyesGuideY}" Tag="Eyes" Cursor="SizeNS"
                    MouseLeftButtonDown="Guide_MouseLeftButtonDown">
                <Rectangle Canvas.Left="0" Canvas.Top="-7" Width="560" Height="14" Fill="Transparent" />
                <Line X1="20" X2="540" Y1="0" Y2="0" Stroke="#FF69F0AE" StrokeThickness="2" StrokeDashArray="{Binding EyesDash}" />
                <TextBlock Canvas.Left="420" Canvas.Top="-19" Text="{Binding EyesLabel}" Foreground="#FF69F0AE" FontSize="12" FontWeight="SemiBold" />
            </Canvas>

            <Canvas Canvas.Top="{Binding ChinGuideY}" Tag="Chin" Cursor="SizeNS"
                    MouseLeftButtonDown="Guide_MouseLeftButtonDown">
                <Rectangle Canvas.Left="0" Canvas.Top="-7" Width="560" Height="14" Fill="Transparent" />
                <Line X1="20" X2="540" Y1="0" Y2="0" Stroke="#FF40C4FF" StrokeThickness="2" StrokeDashArray="{Binding ChinDash}" />
                <TextBlock Canvas.Left="44" Canvas.Top="3" Text="{Binding ChinLabel}" Foreground="#FF40C4FF" FontSize="12" FontWeight="SemiBold" />
            </Canvas>
        </Canvas>
    </Viewbox>
</UserControl>
