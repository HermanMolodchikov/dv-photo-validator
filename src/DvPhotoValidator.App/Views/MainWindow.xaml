<Window x:Class="DvPhotoValidator.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DvPhotoValidator.App.ViewModels"
        xmlns:views="clr-namespace:DvPhotoValidator.App.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="DV Photo Validator"
        Width="1280" Height="820" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop"
        FontSize="13">
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding ExportCommand}" />
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding PreviewCommand}" />
        <KeyBinding Key="A" Modifiers="Control" Command="{Binding AutoAlignCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <DataTemplate x:Key="IssueGroupTemplate" DataType="{x:Type vm:IssueGroupViewModel}">
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10"
                    Background="White">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Right" CornerRadius="10" Padding="8,2"
                                Background="{Binding Status, Converter={StaticResource StatusToBrush}}">
                            <TextBlock Text="{Binding Status, Converter={StaticResource StatusToText}}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" />
                    </DockPanel>
                    <TextBlock Text="{Binding Hint}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,6" />
                    <TextBlock Text="{Binding Placeholder}" Foreground="{StaticResource MutedBrush}" FontStyle="Italic"
                               Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource StatusBadge}" Background="{Binding Status, Converter={StaticResource StatusToBrush}}"
                                            ToolTip="{Binding Status, Converter={StaticResource StatusToText}}">
                                        <TextBlock Text="{Binding Status, Converter={StaticResource StatusToGlyph}}" Foreground="White"
                                                   FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock TextWrapping="Wrap">
                                            <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text="{Binding MeasuredText, Mode=OneWay, StringFormat=' — {0}', TargetNullValue=''}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.LayoutTransform>
            <ScaleTransform ScaleX="{Binding UiScale}" ScaleY="{Binding UiScale}" />
        </Grid.LayoutTransform>
        <DockPanel>
            <!-- Toolbar -->
            <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1" Padding="10,8">
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <Button Content="_Открыть…" Command="{Binding OpenCommand}" ToolTip="Открыть фотографию (Ctrl+O)" />
                        <Button Content="_Автоматически выровнять" Command="{Binding AutoAlignCommand}"
                                ToolTip="Найти лицо и предложить кадр и ориентиры (Ctrl+A)" />
                        <Button Content="Сбросить _кадр" Command="{Binding ResetCropCommand}" ToolTip="Вернуть рамку к исходному положению" />
                        <Button Content="Сбросить _ориентиры" Command="{Binding ResetLandmarksCommand}" ToolTip="Убрать отметки головы, глаз и подбородка" />
                        <Button Content="_Проверить кадр" Command="{Binding CheckFrameCommand}" />
                        <Button Content="Пр_едпросмотр" Command="{Binding PreviewCommand}" ToolTip="Итоговое изображение 600×600 (Ctrl+P)" />
                        <Button Content="_Сохранить JPEG…" Command="{Binding ExportCommand}" Style="{StaticResource PrimaryButton}"
                                ToolTip="Сохранить и повторно проверить файл (Ctrl+S)" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <Label Content="Пр_авила:" Target="{Binding ElementName=ProfileBox}" VerticalAlignment="Center" />
                        <ComboBox x:Name="ProfileBox" Width="300" ItemsSource="{Binding Profiles}"
                                  SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="DisplayName"
                                  ToolTip="Версия требований DV. Значения хранятся в папке Rules рядом с программой." />
                        <Label Content="_Масштаб:" Target="{Binding ElementName=ScaleBox}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        <ComboBox x:Name="ScaleBox" Width="70" ItemsSource="{Binding UiScales}" SelectedItem="{Binding UiScale}"
                                  ItemStringFormat="P0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Status bar -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0" Padding="10,5">
                <DockPanel>
                    <ProgressBar DockPanel.Dock="Right" Width="120" Height="10" IsIndeterminate="True"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               AutomationProperties.LiveSetting="Polite" />
                </DockPanel>
            </Border>

            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="420" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="440" />
                </Grid.ColumnDefinitions>

                <!-- Editor -->
                <DockPanel Grid.Column="0">
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0"
                                Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding SourceInfo}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Editor.CropText}" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Text="{Binding Editor.HeadText}" FontWeight="SemiBold" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding Editor.EyesText}" FontWeight="SemiBold" />
                        <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="Колёсико мыши — масштаб; перетаскивание — сдвиг фото; цветные линии — верх головы (с волосами), линия глаз и низ подбородка. Пометка «авто» — линии поставлены автоматически: проверьте их. Жёлтые точки — то, что нашёл детектор лица. С клавиатуры: стрелки (Shift — быстрее), + и −." />
                    </StackPanel>

                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="#FF2B2B2E">
                        <Grid>
                            <views:CropEditorView DataContext="{Binding Editor}"
                                                  Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibility}}" />
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Visibility="{Binding HasImage, Converter={StaticResource InverseBoolToVisibility}}">
                                <TextBlock Text="Перетащите фотографию сюда" Foreground="White" FontSize="20" HorizontalAlignment="Center" />
                                <TextBlock Text="или нажмите «Открыть…». JPEG, PNG, WebP, BMP, TIFF." Foreground="#FFB0B0B0"
                                           HorizontalAlignment="Center" Margin="0,6,0,0" />
                                <TextBlock Text="Фотографии обрабатываются только на этом компьютере и никуда не отправляются."
                                           Foreground="#FFB0B0B0" HorizontalAlignment="Center" Margin="0,18,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DockPanel>

                <!-- Results -->
                <TabControl Grid.Column="2" SelectedIndex="{Binding SelectedTab}">
                    <TabItem Header="Проверка">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Bottom" Margin="8">
                                <Button DockPanel.Dock="Right" Content="Копировать отчёт" Command="{Binding CopyReportCommand}" Margin="8,0,0,0" />
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12"
                                           Text="Программа помогает подготовить фото, но не гарантирует его принятие и не заменяет официальную проверку. Перед подачей сверьтесь с действующей инструкцией DV." />
                            </DockPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="6">
                                    <ContentControl Content="{Binding SourceGroup}" ContentTemplate="{StaticResource IssueGroupTemplate}" Focusable="False" />
                                    <ContentControl Content="{Binding FrameGroup}" ContentTemplate="{StaticResource IssueGroupTemplate}" Focusable="False" />
                                    <ContentControl Content="{Binding ExportGroup}" ContentTemplate="{StaticResource IssueGroupTemplate}" Focusable="False" />
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="Предпросмотр">
                        <StackPanel Margin="12">
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Width="302" Height="302"
                                    HorizontalAlignment="Left" Background="#FFEFEFEF">
                                <Image Source="{Binding PreviewImage}" Width="300" Height="300"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <TextBlock Text="{Binding PreviewInfo}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            <TextBlock Text="Кадр изменён — обновите предпросмотр." Foreground="#FFB26A00" FontWeight="SemiBold"
                                       Margin="0,6,0,0" Visibility="{Binding PreviewStale, Converter={StaticResource BoolToVisibility}}" />
                            <Button Content="Обновить предпросмотр" Command="{Binding PreviewCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="История">
                        <DockPanel Margin="8">
                            <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"
                                       Text="История текущего сеанса. Она не сохраняется после закрытия программы." />
                            <ListView ItemsSource="{Binding History}">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Время" DisplayMemberBinding="{Binding TimeText}" Width="70" />
                                        <GridViewColumn Header="Действие" DisplayMemberBinding="{Binding Action}" Width="120" />
                                        <GridViewColumn Header="Подробности" DisplayMemberBinding="{Binding Details}" Width="220" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Grid>
        </DockPanel>
    </Grid>

</Window>
