<Application x:Class="DvPhotoValidator.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:DvPhotoValidator.App.Resources"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <res:StatusToBrushConverter x:Key="StatusToBrush" />
            <res:StatusToGlyphConverter x:Key="StatusToGlyph" />
            <res:StatusToTextConverter x:Key="StatusToText" />
            <res:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <res:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
            <res:NullToVisibilityConverter x:Key="NullToVisibility" />

            <SolidColorBrush x:Key="PanelBrush" Color="#FFF7F7F8" />
            <SolidColorBrush x:Key="BorderBrush" Color="#FFDDDDE1" />
            <SolidColorBrush x:Key="MutedBrush" Color="#FF5F6368" />
            <SolidColorBrush x:Key="AccentBrush" Color="#FF1A5FB4" />

            <Style TargetType="Button">
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="Margin" Value="0,0,6,0" />
                <Setter Property="MinHeight" Value="30" />
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            </Style>

            <Style x:Key="StatusBadge" TargetType="Border">
                <Setter Property="Width" Value="22" />
                <Setter Property="Height" Value="22" />
                <Setter Property="CornerRadius" Value="11" />
                <Setter Property="VerticalAlignment" Value="Top" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
